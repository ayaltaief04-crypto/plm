{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,               // 👈 On passe à false pour être moins bloqué par les types 'any'
    "noImplicitAny": false,        // 👈 Autorise le 'data' sans type dans tes subscribes
    "paths": {
      "@app/*": ["src/app/*"],     // 👈 Optionnel : permet d'utiliser @app/core/...
      "src/*": ["src/*"]           // 👈 IMPORTANT : pour que tes imports 'src/app/...' fonctionnent
    },
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false, // 👈 Moins strict sur l'injection de services
    "strictInputAccessModifiers": false,
    "strictTemplates": false           // 👈 Évite les erreurs rouges dans tes fichiers HTML
  }
  }
  